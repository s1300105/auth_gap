  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "reachscan",
          "version": "0.4.0",
          "informationUri": "https://github.com/vinmay/reachscan",
          "rules": [
            {
              "id": "reachscan/EXECUTE",
              "name": "Execute",
              "shortDescription": {
                "text": "EXECUTE capability"
              },
              "fullDescription": {
                "text": "This code can execute shell or interpreter commands on the host."
              },
              "help": {
                "text": "This code can execute shell or interpreter commands on the host. A malicious prompt could run destructive commands, install malware, or alter the environment."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "execute"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "reachscan/SEND",
              "name": "Send",
              "shortDescription": {
                "text": "SEND capability"
              },
              "fullDescription": {
                "text": "This code can send data over the network to external services."
              },
              "help": {
                "text": "This code can send data over the network to external services. Sensitive local data could be transmitted to untrusted endpoints."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "send"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "reachscan/READ",
              "name": "Read",
              "shortDescription": {
                "text": "READ capability"
              },
              "fullDescription": {
                "text": "This code can read local files from the filesystem."
              },
              "help": {
                "text": "This code can read local files from the filesystem. Private files may be exposed to later processing or exfiltration."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "read"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "reachscan/WRITE",
              "name": "Write",
              "shortDescription": {
                "text": "WRITE capability"
              },
              "fullDescription": {
                "text": "This code can write, modify, move, or delete files."
              },
              "help": {
                "text": "This code can write, modify, move, or delete files. An unsafe prompt could tamper with project files or remove important data."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "write"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "reachscan/SECRETS",
              "name": "Secrets",
              "shortDescription": {
                "text": "SECRETS capability"
              },
              "fullDescription": {
                "text": "This code accesses secrets or credential sources."
              },
              "help": {
                "text": "This code accesses secrets or credential sources. Credentials may be disclosed and used for unauthorized access."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "secrets"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "reachscan/DYNAMIC",
              "name": "Dynamic",
              "shortDescription": {
                "text": "DYNAMIC capability"
              },
              "fullDescription": {
                "text": "This code performs dynamic execution or runtime code loading."
              },
              "help": {
                "text": "This code performs dynamic execution or runtime code loading. Untrusted input could become executable code, increasing compromise risk."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "dynamic"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "reachscan/AUTONOMY",
              "name": "Autonomy",
              "shortDescription": {
                "text": "AUTONOMY capability"
              },
              "fullDescription": {
                "text": "This code can schedule or continue actions without direct user interaction."
              },
              "help": {
                "text": "This code can schedule or continue actions without direct user interaction. Risky behavior may repeat in the background after the initiating prompt."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "autonomy"
                ],
                "security-severity": "5.0"
              }
            },
            {
              "id": "mcp-risk-mismatch",
              "name": "McpRiskMismatch",
              "shortDescription": {
                "text": "MCP tool annotation contradicted by reachable code"
              },
              "fullDescription": {
                "text": "An MCP tool explicitly declares a ToolAnnotations hint (readOnlyHint, openWorldHint, or destructiveHint) that a call path from the tool contradicts."
              },
              "help": {
                "text": "Clients use these hints to decide what to auto-approve. A false hint can let a tool that writes, executes, or reaches the network run without the approval the client would otherwise ask for. Fix the code or correct the annotation."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "reachscan",
                  "mcp",
                  "annotations"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "reachscan/combined/data_exfiltration",
              "name": "DataExfiltration",
              "shortDescription": {
                "text": "Data Exfiltration Risk"
              },
              "fullDescription": {
                "text": "The code can both access/change local files and send data externally."
              },
              "help": {
                "text": "The code can both access/change local files and send data externally."
              },
              "helpUri": "https://github.com/vinmay/reachscan",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
